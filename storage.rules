rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    // Profile photos: anyone can view, only the owner can upload (max 5 MB images).
    match /profile_images/{file} {
      allow read: if true;
      allow write: if request.auth != null && file == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    // Product images are managed from the admin dashboard.
    match /products/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
